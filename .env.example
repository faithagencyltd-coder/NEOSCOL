# Copier en .env.local et renseigner les valeurs du projet Supabase
# (Tableau de bord Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon
# Clé serveur : NE JAMAIS l'exposer au navigateur ni la committer.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique de l'application (liens des e-mails et QR Codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret des tâches planifiées (rappels d'impayés : GET /api/cron/rappels)
CRON_SECRET=

# Mode démonstration : changement de rôle en un clic entre les comptes de
# démonstration (page /demo et accès rapide sur /connexion). NE PAS activer en production.
NEOSCOL_DEMO_MODE=
# Mot de passe des comptes de démonstration (par défaut celui de supabase/seed.sql)
NEOSCOL_DEMO_PASSWORD=

# Assistant intelligent (optionnel) : clé de l'API Claude (Anthropic). Sans clé,
# l'assistant fonctionne avec un aiguillage local vers les mêmes outils sécurisés.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Abonnements NéoScol (paiement de l'abonnement par l'établissement à NéoScol)
# Variables SERVEUR uniquement : ne JAMAIS les préfixer NEXT_PUBLIC_.
# Environnements séparés : chaque déploiement (test / staging / production)
# a ses propres valeurs ; une transaction créée en test ne peut être confirmée
# qu'en test (le mode est enregistré sur chaque transaction).
# -----------------------------------------------------------------------------
# Fournisseur actif : paydunya | simulation (paiement simulé, développement local
# uniquement). Vide : paiement en ligne désactivé (paiement manuel par la plateforme).
PAYMENT_PROVIDER=
# test (bac à sable PayDunya) | live (production)
PAYDUNYA_MODE=test
# Clés du compte marchand PayDunya (tableau de bord PayDunya → Intégrer notre API).
# Utiliser les clés de TEST en développement ; jamais de vraies clés dans Git.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
# Secret ajouté à l'URL de notification (/api/webhooks/payments/paydunya?cle=…).
# Recommandé en production ; la preuve de paiement reste la vérification serveur auprès de PayDunya.
PAYMENT_WEBHOOK_SECRET=
# Autorise le paiement simulé hors développement (démonstration locale seulement).
# NE JAMAIS activer sur un serveur de production réel.
PAYMENT_ALLOW_SIMULATION=
# Tâche quotidienne des abonnements (essais, impayés, renouvellements) :
#   GET /api/cron/abonnements  avec  Authorization: Bearer <CRON_SECRET>
