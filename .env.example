# Copier en .env.local et renseigner les valeurs du projet Supabase
# (Tableau de bord Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon
# Clé serveur : NE JAMAIS l'exposer au navigateur ni la committer.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique de l'application (liens des e-mails et QR Codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret des tâches planifiées (rappels d'impayés : GET /api/cron/rappels)
CRON_SECRET=
